{
  "realm": "mcp-claro",
  "displayName": "MCP-CLARO",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR",
    "en"
  ],
  "defaultLocale": "pt-BR",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "accessCodeLifespan": 60,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "defaultDefaultClientScopes": [
    "basic",
    "mcp-claro"
  ],
  "defaultOptionalClientScopes": [],
  "clientScopes": [
    {
      "name": "basic",
      "description": "Reivindicacoes basicas: sub e auth_time.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Nome da pessoa no cracha (name e preferred_username). So para aplicativos de pessoas.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "usuario",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "nome completo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "mcp-claro",
      "description": "Recurso do MCP-CLARO: poe PUBLIC_BASE_URL/mcp na audiencia (aud) do cracha. Padrao em todos os clientes que falam com o MCP-CLARO.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audiencia-mcp-claro",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${MCP_CLARO_RECURSO:https://mcp-claro.localhost/mcp}",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "outro-servico",
      "description": "SO DE TESTE. Outro recurso (outro condominio): cracha com audiencia que nao e a do MCP-CLARO.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audiencia-outro-servico",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://outro-servico.localhost/api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "claude-code",
      "name": "Claude Code",
      "description": "Aplicativo publico de IA usado por pessoas. Authorization code com PKCE S256, sem segredo, retorno so em loopback.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "mcp-claro"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "goose",
      "name": "Goose",
      "description": "Aplicativo publico de IA usado por pessoas. Authorization code com PKCE S256, sem segredo, retorno so em loopback.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "mcp-claro"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "mcp-claro-ronda",
      "name": "MCP-CLARO ronda",
      "description": "Programa que roda sozinho (nasce na Fase 1). Conta de servico com JWT assinado (private_key_jwt, ES256); o Keycloak guarda so a chave publica em jwks.string. Sem chave cadastrada, nao entra.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "access.token.lifespan": "300",
        "use.jwks.url": "false",
        "use.jwks.string": "true",
        "jwks.string": "{\"keys\":[]}",
        "token.endpoint.auth.signing.alg": "ES256",
        "token.endpoint.auth.signing.max.exp": "60",
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "mcp-claro"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "mcp-claro-vigia",
      "name": "MCP-CLARO vigia",
      "description": "Programa que roda sozinho na segunda maquina (nasce na Fase 1). Conta de servico com JWT assinado (private_key_jwt, ES256); o Keycloak guarda so a chave publica em jwks.string. Sem chave cadastrada, nao entra.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "access.token.lifespan": "300",
        "use.jwks.url": "false",
        "use.jwks.string": "true",
        "jwks.string": "{\"keys\":[]}",
        "token.endpoint.auth.signing.alg": "ES256",
        "token.endpoint.auth.signing.max.exp": "60",
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "mcp-claro"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "mcp-claro-teste-cc",
      "name": "SO DE TESTE: cracha por client_credentials",
      "description": "SO DE TESTE AUTOMATIZADO. Nunca em piloto ou producao. Desligado se MCP_CLARO_CLIENTES_DE_TESTE nao for true; o segredo vem de MCP_CLARO_TESTE_CC_SEGREDO.",
      "enabled": "${MCP_CLARO_CLIENTES_DE_TESTE:false}",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MCP_CLARO_TESTE_CC_SEGREDO}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "access.token.lifespan": "300",
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "mcp-claro"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "outro-servico",
      "name": "SO DE TESTE: outro condominio",
      "description": "SO DE TESTE AUTOMATIZADO. Recebe cracha com a audiencia de outro recurso, para provar que o MCP-CLARO recusa. Desligado se MCP_CLARO_CLIENTES_DE_TESTE nao for true; o segredo vem de MCP_CLARO_OUTRO_SERVICO_SEGREDO.",
      "enabled": "${MCP_CLARO_CLIENTES_DE_TESTE:false}",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MCP_CLARO_OUTRO_SERVICO_SEGREDO}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "access.token.lifespan": "300",
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "outro-servico"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "mcp-claro-telas",
      "name": "Telas do MCP-CLARO",
      "description": "Login das pessoas nas telas do gateway. Cliente confidencial (segredo vindo do ambiente), authorization code com PKCE S256 obrigatorio e retorno so no endereco publico.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MCP_CLARO_TELAS_SEGREDO}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "${MCP_CLARO_PUBLICO:https://mcp-claro.localhost}/telas/login/volta"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "profile"
      ],
      "optionalClientScopes": []
    }
  ],
  "components": {
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Trusted Hosts",
        "providerId": "trusted-hosts",
        "subType": "anonymous",
        "config": {
          "trusted-hosts": [],
          "host-sending-registration-request-must-match": [
            "true"
          ],
          "client-uris-must-match": [
            "true"
          ]
        }
      },
      {
        "name": "Sem cadastro anonimo",
        "providerId": "max-clients",
        "subType": "anonymous",
        "config": {
          "max-clients": [
            "0"
          ]
        }
      },
      {
        "name": "Sem cadastro por token",
        "providerId": "max-clients",
        "subType": "authenticated",
        "config": {
          "max-clients": [
            "0"
          ]
        }
      }
    ]
  }
}
