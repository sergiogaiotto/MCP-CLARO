# Portao proprio do MCP-CLARO (EDGE_MODE=proprio).
# Atende a internet com TLS, aplica o limite grosso por endereco de origem e chama
# a entrada com mTLS. Nao repete pedidos e nao decide nada por cabecalhos MCP.
{
	order rate_limit before reverse_proxy
	servers {
		trusted_proxies static private_ranges
		# Host diferente do nome pedido no TLS (SNI) recebe 421: o portao nao responde por endereco que nao
		# serve, nem com 200 vazio (protecao de Host, como no cenario de DNS rebinding da suite oficial).
		strict_sni_host on
	}
}

{$PUBLIC_HOST:mcp-claro.localhost} {
	encode zstd gzip

	rate_limit {
		zone por_origem {
			key {remote_host}
			events {$EDGE_RATE_PER_IP_PER_MINUTE:120}
			window 1m
		}
	}

	request_body {
		max_size 4MB
	}

	# O console de administracao do Keycloak nunca passa pelo portao publico.
	handle /login/admin* {
		respond "Nao disponivel por este endereco." 403
	}

	# Paineis do Grafana (root_url /paineis/), pela rede interna com TLS da autoridade interna.
	handle /paineis/* {
		reverse_proxy https://grafana:3000 {
			transport http {
				tls_trust_pool file /run/secrets/ca_interna.pem
				tls_server_name grafana
			}
		}
	}

	# Provedor de login (Keycloak) no mesmo endereco publico: o emissor dos crachas e /login.
	handle /login/* {
		reverse_proxy http://login:8080
	}

	handle {
		reverse_proxy https://entrada:{$GATEWAY_INTERNAL_PORT:8443} {
			# Com upstream HTTPS o Caddy troca o Host pelo da entrada ("entrada:8443"); a entrada confere o
			# Host publico (ALLOWED_HOSTS) e recusaria todo pedido MCP com 421. O Host segue como veio.
			header_up Host {host}
			transport http {
				tls_client_auth /run/secrets/portao_cliente_cert.pem /run/secrets/portao_cliente_key.pem
				tls_trust_pool file /run/secrets/ca_interna.pem
				tls_server_name entrada
			}
			# Sem novas tentativas: o portao nunca repete um pedido.
			lb_retries 0
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
